{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting state",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "changed_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "triState": { "type": ["boolean", "null"] },
    "claim": {
      "oneOf": [
        { "$ref": "#/$defs/fact" },
        { "$ref": "#/$defs/proposal" },
        { "$ref": "#/$defs/risk" }
      ]
    },
    "base": {
      "type": "object",
      "required": ["id", "kind", "assessment"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "importance": { "enum": ["normal", "important"] },
        "evidence_state": { "enum": ["confirmed", "refuted", "unknown", "conflicting"] },
        "conflicting_evidence": { "type": "boolean", "default": false },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        },
        "assessment": { "type": "object" }
      },
      "additionalProperties": true
    },
    "fact": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "kind": { "const": "fact" },
            "verification": {
              "type": "object",
              "required": ["claim_scope", "required_path", "evidence"],
              "properties": {
                "claim_scope": {
                  "type": "object",
                  "required": ["product", "feature", "plan", "account_context", "checked_at"],
                  "properties": {
                    "product": { "type": "string", "minLength": 1 },
                    "feature": { "type": "string", "minLength": 1 },
                    "plan": { "type": "string", "minLength": 1 },
                    "account_context": { "type": "string", "minLength": 1 },
                    "checked_at": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                },
                "required_path": { "enum": ["published", "account", "operational"] },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["path", "source", "scope_matches"],
                    "properties": {
                      "path": { "enum": ["published", "account", "operational"] },
                      "source": { "type": "string", "minLength": 1 },
                      "scope_matches": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "assessment": {
              "type": "object",
              "required": ["direct", "current", "corroborated"],
              "properties": {
                "direct": { "$ref": "#/$defs/triState" },
                "current": { "$ref": "#/$defs/triState" },
                "corroborated": { "$ref": "#/$defs/triState" }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "proposal": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "kind": { "const": "proposal" },
            "assessment": {
              "type": "object",
              "required": ["feasible", "beneficial", "preferable"],
              "properties": {
                "feasible": { "$ref": "#/$defs/triState" },
                "beneficial": { "$ref": "#/$defs/triState" },
                "preferable": { "$ref": "#/$defs/triState" }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "risk": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "kind": { "const": "risk" },
            "assessment": {
              "type": "object",
              "required": ["likely", "severe", "manageable"],
              "properties": {
                "likely": { "$ref": "#/$defs/triState" },
                "severe": { "$ref": "#/$defs/triState" },
                "manageable": { "$ref": "#/$defs/triState" }
              },
              "additionalProperties": false
            },
            "mitigation_state": { "enum": ["대응 검증됨", "대응 가능", "대응 확인 필요", "대응 어려움"] },
            "blocking": { "type": "boolean", "default": false }
          }
        }
      ]
    }
  }
}
