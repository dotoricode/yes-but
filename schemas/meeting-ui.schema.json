{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User-visible dynamic meeting",
  "type": "object",
  "required": ["participants", "messages"],
  "properties": {
    "participants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "focus", "introduced_at"],
        "properties": {
          "name": {"type": "string", "pattern": "^[가-힣][가-힣 ]{0,19}$"},
          "focus": {"type": "string", "minLength": 1},
          "introduced_at": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {"$ref": "meeting-event.schema.json"}
    },
    "allowed_originals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
