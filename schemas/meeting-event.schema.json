{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User-visible meeting event",
  "type": "object",
  "required": ["role", "text"],
  "properties": {
    "role": {
      "enum": ["진행자", "탐험가", "합성자", "현실 검토자"]
    },
    "text": { "type": "string", "minLength": 1 },
    "allowed_originals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
